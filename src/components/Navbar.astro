---
const navItems = [
  { label: { en: 'About', zh: '关于' }, href: '#about' },
  { label: { en: 'Experience', zh: '经历' }, href: '#experience' },
  { label: { en: 'Skills', zh: '技能' }, href: '#skills' },
  { label: { en: 'Projects', zh: '项目' }, href: '#work' },
  { label: { en: 'Education', zh: '教育' }, href: '#education' },
  { label: { en: 'Contact', zh: '联系' }, href: '#contact' },
];
---

<header id="site-nav" class="site-nav fixed top-0 left-0 right-0 z-50">
  <nav class="max-w-6xl mx-auto flex items-center justify-between h-14 px-6">
    <a href="#hero" class="text-[15px] font-semibold tracking-tight" aria-label="Home">
      Tushar Kiran<span class="logo-dot" aria-hidden="true"></span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link text-sm px-4 py-2 rounded-full">
          <span class="lang-en">{item.label.en}</span>
          <span class="lang-zh">{item.label.zh}</span>
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <div class="lang-toggle flex items-center gap-1" role="group" aria-label="Language">
        <button data-lang="en" class="text-sm px-3 py-1.5 rounded-full active" aria-label="English">
          EN
        </button>
        <button data-lang="zh" class="text-sm px-3 py-1.5 rounded-full" aria-label="中文">
          中文
        </button>
      </div>
      <a
        href="#contact"
        class="hidden sm:inline-block px-4 py-2 bg-gold text-bg text-sm font-medium rounded-full hover:brightness-110 transition"
      >
        <span class="lang-en">Let's talk</span>
        <span class="lang-zh">联系</span>
      </a>
    </div>
  </nav>
</header>
