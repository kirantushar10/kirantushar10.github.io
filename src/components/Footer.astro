---
const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-rule">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <!-- Brand -->
      <div class="flex items-center gap-4">
        <span class="w-9 h-9 border border-amber-dim flex items-center justify-center font-mono text-xs font-semibold text-amber">
          TK
        </span>
        <div>
          <p class="text-sm font-semibold text-ink">Tushar Kiran</p>
          <p class="text-xs font-mono text-muted mt-0.5">AI/ML Engineer · Munich, Germany</p>
        </div>
      </div>

      <!-- Socials -->
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/kirantushar10"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="w-9 h-9 border border-rule flex items-center justify-center text-muted hover:text-amber hover:border-amber-dim transition-colors duration-300"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.9 1.3 3.6 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        </a>
        <a
          href="https://linkedin.com/in/kirantushar10"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="w-9 h-9 border border-rule flex items-center justify-center text-muted hover:text-amber hover:border-amber-dim transition-colors duration-300"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.13 1 2.5 1s2.48 1.13 2.48 2.5zM.3 8h4.4v14H.3V8zM8 8h4.2v1.9h.1c.6-1 2-2.1 4.2-2.1 4.5 0 5.3 3 5.3 6.8V22h-4.4v-6.3c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V22H8V8z"/></svg>
        </a>
        <a
          href="mailto:kirantushar10@gmail.com"
          aria-label="Email"
          class="w-9 h-9 border border-rule flex items-center justify-center text-muted hover:text-amber hover:border-amber-dim transition-colors duration-300"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-rule text-center">
      <p class="text-xs font-mono text-muted/70">
        © {currentYear} Tushar Kiran. Built with Astro &amp; React.
      </p>
    </div>
  </div>
</footer>
