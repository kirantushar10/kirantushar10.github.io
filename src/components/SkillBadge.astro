---
interface Props {
  name: string;
  level?: 'expert' | 'proficient' | 'familiar';
  category?: 'ai' | 'backend' | 'database' | 'language';
}

const { name, level = 'proficient', category = 'language' } = Astro.props;
---

<button
  class="group relative px-3.5 py-1.5 text-xs font-mono text-ink/80 border border-rule bg-char-soft/40 hover:border-amber-dim hover:text-ink transition-colors duration-200"
  aria-label={`${name} skill badge`}
>
  <span class="relative z-10 flex items-center gap-2">
    <span
      class="w-1.5 h-1.5 rounded-full bg-amber/70 group-hover:bg-amber group-hover:scale-150 transition-transform duration-200"
    />
    {name}
  </span>
</button>