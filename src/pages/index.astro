---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Cinematic from '../components/Cinematic';
import TimelineLine from '../components/TimelineLine';
import '../styles/globals.css';
import { caseStudies, projects, experiences, skillGroups } from '../data/work';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Tushar Kiran | AI/ML Engineer</title>
    <meta
      name="description"
      content="Tushar Kiran builds production LLM applications, RAG pipelines, and agentic systems. AI/ML engineer in Munich, Germany."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kirantushar10.github.io/" />
    <meta property="og:title" content="Tushar Kiran | AI/ML Engineer" />
    <meta property="og:description" content="Production LLM applications, RAG pipelines, and agentic systems. Based in Munich, Germany." />
    <meta property="og:image" content="https://kirantushar10.github.io/hero-bg.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('lang') === 'zh') {
          document.documentElement.classList.add('zh');
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <!-- One scroll clock: progress bar, trailing glow, all parallax layers -->
    <Cinematic client:visible />

    <Navbar />

    <main class="relative z-10">
      <!-- ============================== HERO ============================== -->
      <section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
        <!-- Layer: backdrop art (parallax slow + Ken Burns inside) -->
        <div class="absolute inset-0 pointer-events-none" data-parallax="0.15" aria-hidden="true">
          <div class="hero-bg w-full h-full bg-cover bg-center" style="background-image: url(/hero-bg.png); filter: saturate(0.4) brightness(0.36) contrast(1.05);" />
          <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(20,21,19,0.7) 0%, rgba(20,21,19,0.5) 45%, rgba(20,21,19,0.96) 100%);" />
        </div>

        <!-- Layer: character (parallax faster, floats) -->
        <div class="absolute bottom-0 right-0 hidden lg:block pointer-events-none" data-parallax="0.5" aria-hidden="true">
          <div
            class="hero-character w-[clamp(280px,32vw,480px)] h-auto"
            style="
              background-image: url(/hero-character.png);
              background-size: contain;
              background-position: bottom center;
              background-repeat: no-repeat;
              mix-blend-mode: screen;
              filter: saturate(0.8) brightness(0.95) drop-shadow(0 24px 80px rgba(217,198,164,0.18));
              opacity: 0.92;
            "
          />
        </div>

        <div class="relative w-full max-w-5xl mx-auto px-6 py-28">
          <p class="font-mono text-xs tracking-[0.22em] text-gold uppercase mb-6" data-reveal>
            <span class="lang-en">AI/ML Engineer · Munich, Germany</span>
            <span class="lang-zh">AI/ML 工程师 · 德国慕尼黑</span>
          </p>

          <h1
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold tracking-[-0.03em] leading-[0.98]"
            data-reveal
          >
            <span class="mask-line">
              <span class="reveal-inner"><span class="lang-en">Building</span><span class="lang-zh">构建</span></span>
            </span>
            <span class="mask-line" style="--rd: 120ms">
              <span class="reveal-inner"><span class="lang-en">AI Agents</span><span class="lang-zh">智能体</span> <span class="text-gold">&amp;</span> RAG</span>
            </span>
            <span class="mask-line" style="--rd: 240ms">
              <span class="reveal-inner"><span class="lang-en">Pipelines</span><span class="lang-zh">检索管线</span></span>
            </span>
          </h1>

          <div class="mt-10 grid gap-10 md:grid-cols-12 items-end" data-reveal style="--rd: 380ms">
            <div class="md:col-span-7">
              <p class="text-base sm:text-lg leading-relaxed text-mid max-w-xl">
                <span class="lang-en">
                  I architect production LLM applications, retrieval-augmented generation
                  systems, and agentic workflows for enterprise engineering platforms.
                </span>
                <span class="lang-zh">
                  我为企业级工程平台构建生产级 LLM 应用、检索增强生成系统与智能体工作流。
                </span>
              </p>
              <div class="mt-8 flex flex-wrap gap-4">
                <a href="#work" class="px-6 py-3 bg-gold text-bg text-sm font-medium rounded-lg hover:brightness-110 transition">
                  <span class="lang-en">View Work</span>
                  <span class="lang-zh">查看作品</span>
                </a>
                <a href="#contact" class="px-6 py-3 border border-rule text-mid text-sm rounded-lg hover:text-ink hover:border-gold/50 transition">
                  <span class="lang-en">Get in Touch</span>
                  <span class="lang-zh">联系我</span>
                </a>
              </div>
            </div>
            <div class="md:col-span-5 flex md:justify-end" data-parallax="0.08">
              <p class="font-mono text-xs sm:text-sm text-dim">
                [ <span class="lang-en">AI/ML Specialist · Munich, DE</span><span class="lang-zh">AI/ML 专家 · 慕尼黑</span> ]
                <span class="caret" aria-hidden="true"></span>
              </p>
            </div>
          </div>

          <div class="mt-14 flex items-center gap-3 scroll-cue" aria-hidden="true" data-reveal style="--rd: 500ms">
            <span class="w-px h-8 bg-gold/40"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-dim">
              <span class="lang-en">Scroll</span><span class="lang-zh">向下滚动</span>
            </span>
          </div>
        </div>
      </section>

      <!-- ============================== 01 — ABOUT ============================== -->
      <section id="about" class="py-28 md:py-40 px-6 border-t border-rule">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-baseline gap-4 mb-12" data-reveal>
            <span class="font-mono text-xs text-gold">01</span>
            <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
            <h2 class="text-xl font-semibold tracking-tight">
              <span class="lang-en">About Me</span><span class="lang-zh">关于我</span>
            </h2>
          </div>

          <div class="grid gap-12 md:grid-cols-12">
            <div class="md:col-span-7" data-parallax="0.05">
              <p class="mask-line" data-reveal>
                <span class="reveal-inner text-2xl sm:text-3xl md:text-[2rem] font-medium leading-[1.3] tracking-tight text-ink">
                  <span class="lang-en">
                    I turn messy enterprise data into reliable AI systems — RAG pipelines that
                    answer with grounding, agents that route themselves, and the MLOps that keeps
                    both honest.
                  </span>
                  <span class="lang-zh">
                    我把杂乱的企业数据变成可靠的 AI 系统——有溯源的 RAG 管线、自主路由的智能体，以及让两者保持诚实的 MLOps。
                  </span>
                </span>
              </p>
              <p class="mt-8 text-base leading-relaxed text-mid max-w-xl" data-reveal style="--rd: 160ms">
                <span class="lang-en">
                  I recently completed my AI/ML engineering internship at
                  <strong class="text-ink font-semibold">Analog Devices</strong>, where I built an
                  AI-assisted engineering analytics platform — an intent-aware RAG pipeline over a
                  knowledge graph, backed by FastAPI, PostgreSQL, Redis, and Apache Airflow.
                </span>
                <span class="lang-zh">
                  我最近完成了在 <strong class="text-ink font-semibold">Analog Devices（模拟器件）</strong>
                  的 AI/ML 工程实习，构建了一个 AI 辅助的工程分析平台——基于知识图谱的意图感知 RAG
                  管线，底层为 FastAPI、PostgreSQL、Redis 与 Apache Airflow。
                </span>
              </p>
            </div>

            <div class="md:col-span-5 space-y-6" data-reveal data-reveal="right" style="--rd: 200ms">
              <div class="border-t border-rule pt-4">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-gold mb-2">
                  <span class="lang-en">Core focus</span><span class="lang-zh">核心方向</span>
                </h3>
                <p class="text-sm text-mid leading-relaxed">
                  <span class="lang-en">Agentic RAG · LangGraph reasoning · Cost-aware LLM routing · Vector search</span>
                  <span class="lang-zh">智能体 RAG · LangGraph 推理 · 成本感知 LLM 路由 · 向量检索</span>
                </p>
              </div>
              <div class="border-t border-rule pt-4">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-gold mb-2">
                  <span class="lang-en">Education</span><span class="lang-zh">教育</span>
                </h3>
                <p class="text-sm text-mid leading-relaxed">
                  <span class="lang-en">M.Sc. Artificial Intelligence (BTU Cottbus) · B.E. Information Science (SJB Institute)</span>
                  <span class="lang-zh">人工智能硕士（BTU Cottbus）· 信息科学学士（SJB 学院）</span>
                </p>
              </div>
              <div class="border-y border-rule py-4">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-gold mb-2">
                  <span class="lang-en">Location</span><span class="lang-zh">所在地</span>
                </h3>
                <p class="text-sm text-mid leading-relaxed">
                  <span class="lang-en">Munich, Germany · Open to AI engineering collaborations</span>
                  <span class="lang-zh">德国慕尼黑 · 欢迎 AI 工程方向的合作</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== 02 — EXPERIENCE ============================== -->
      <section id="experience" class="py-28 md:py-40 px-6 border-t border-rule">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-baseline gap-4 mb-14" data-reveal>
            <span class="font-mono text-xs text-gold">02</span>
            <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
            <h2 class="text-xl font-semibold tracking-tight">
              <span class="lang-en">Work Experience</span><span class="lang-zh">工作经历</span>
            </h2>
          </div>

          <div class="relative pl-8 sm:pl-12">
            <!-- Hairline rail + scroll-drawn gold spine -->
            <div class="tl-rail" aria-hidden="true"></div>
            <TimelineLine client:visible />

            <div class="space-y-14 md:space-y-16">
              {experiences.map((exp, i) => (
                <div class="relative" data-reveal style={`--rd: ${i * 90}ms`}>
                  <span class="tl-node" aria-hidden="true" />
                  <div class="border-t border-rule pt-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-2">
                      <h3 class="text-xl md:text-2xl font-semibold tracking-tight">
                        <span class="lang-en">{exp.role.en}</span>
                        <span class="lang-zh">{exp.role.zh}</span>
                      </h3>
                      <span class="font-mono text-xs text-gold whitespace-nowrap">{exp.period}</span>
                    </div>
                    <p class="text-sm text-dim mb-4">
                      {exp.company} · <span class="lang-en">{exp.location.en}</span><span class="lang-zh">{exp.location.zh}</span>
                    </p>
                    <ul class="space-y-2.5 text-[15px] text-mid leading-relaxed">
                      {exp.bullets.en.map((b) => (
                        <li class="lang-en flex items-start gap-3">
                          <span class="text-gold mt-px text-xs shrink-0" aria-hidden="true">▸</span>
                          <span>{b}</span>
                        </li>
                      ))}
                      {exp.bullets.zh.map((b) => (
                        <li class="lang-zh flex items-start gap-3">
                          <span class="text-gold mt-px text-xs shrink-0" aria-hidden="true">▸</span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== 03 — SKILLS ============================== -->
      <section id="skills" class="py-28 md:py-40 px-6 border-t border-rule">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-baseline gap-4 mb-14" data-reveal>
            <span class="font-mono text-xs text-gold">03</span>
            <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
            <h2 class="text-xl font-semibold tracking-tight">
              <span class="lang-en">Skills</span><span class="lang-zh">技能</span>
            </h2>
          </div>

          <div class="space-y-12">
            {skillGroups.map((g, i) => (
              <div data-reveal style={`--rd: ${i * 80}ms`} data-parallax={i % 2 === 0 ? '0.03' : '-0.03'}>
                <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-dim mb-5">
                  <span class="text-gold" aria-hidden="true">—</span>
                  <span class="lang-en">{g.label.en}</span><span class="lang-zh">{g.label.zh}</span>
                </h3>
                <div class="flex flex-wrap gap-2.5">
                  {g.items.map((s) => (
                    <span class="chip">{s}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================== 04 — PROJECTS ============================== -->
      <section id="work" class="py-28 md:py-40 px-6 border-t border-rule">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-baseline gap-4 mb-6" data-reveal>
            <span class="font-mono text-xs text-gold">04</span>
            <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
            <h2 class="text-xl font-semibold tracking-tight">
              <span class="lang-en">Projects</span><span class="lang-zh">项目</span>
            </h2>
          </div>
          <p class="text-sm text-dim mb-12" data-reveal style="--rd: 100ms">
            <span class="lang-en">Case studies first — deep dives into the systems I shipped. Then the rest of the build list.</span>
            <span class="lang-zh">先展示案例研究——深入我交付的系统；其余项目随后列出。</span>
          </p>

          <!-- Case studies (full detail pages) -->
          <div class="space-y-1.5 mb-20">
            {caseStudies.map((cs, i) => (
              <article class="work-row relative rounded-xl overflow-hidden" data-reveal style={`--rd: ${i * 90}ms`}>
                <a href={`/work/${cs.slug}/`} class="block px-5 py-7 sm:px-7 sm:py-9">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="font-mono text-xs text-dim">{cs.index}</span>
                    <span class="font-mono text-xs text-gold">{cs.year}</span>
                    <span class="font-mono text-xs text-dim">
                      · <span class="lang-en">{cs.role.en}</span><span class="lang-zh">{cs.role.zh}</span>
                    </span>
                  </div>
                  <h3 class="work-title text-xl sm:text-2xl font-semibold tracking-tight flex items-center gap-3">
                    <span class="lang-en">{cs.title.en}</span>
                    <span class="lang-zh">{cs.title.zh}</span>
                    <span class="work-arrow text-gold" aria-hidden="true">↗</span>
                  </h3>
                  <p class="mt-2 text-sm sm:text-[15px] text-mid leading-relaxed max-w-2xl">
                    <span class="lang-en">{cs.summary.en}</span>
                    <span class="lang-zh">{cs.summary.zh}</span>
                  </p>
                </a>
                <span class="work-underline" aria-hidden="true"></span>
              </article>
            ))}
          </div>

          <!-- More projects grid -->
          <h3 class="font-mono text-[11px] uppercase tracking-[0.2em] text-dim mb-6" data-reveal>
            <span class="text-gold" aria-hidden="true">—</span>
            <span class="lang-en">More builds</span><span class="lang-zh">更多项目</span>
          </h3>
          <div class="grid gap-1.5 sm:grid-cols-2">
            {projects.map((p, i) => (
              <article class="work-row relative rounded-xl overflow-hidden" data-reveal style={`--rd: ${(i % 2) * 80}ms`}>
                <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" class="block px-5 py-6">
                  <div class="flex items-center justify-between gap-3">
                    <h4 class="work-title text-base font-semibold tracking-tight">{p.title}</h4>
                    <span class="flex items-center gap-3">
                      <span class="font-mono text-[11px] text-dim">{p.year}</span>
                      <span class="work-arrow text-gold" aria-hidden="true">↗</span>
                    </span>
                  </div>
                  <p class="mt-2 text-[13.5px] text-mid leading-relaxed">
                    <span class="lang-en">{p.description.en}</span>
                    <span class="lang-zh">{p.description.zh}</span>
                  </p>
                  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
                    {p.tags.map((t) => (
                      <span class="font-mono text-[11px] text-dim">{t}</span>
                    ))}
                  </div>
                </a>
                <span class="work-underline" aria-hidden="true"></span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================== 05 — EDUCATION ============================== -->
      <section id="education" class="py-28 md:py-40 px-6 border-t border-rule">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-baseline gap-4 mb-14" data-reveal>
            <span class="font-mono text-xs text-gold">05</span>
            <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
            <h2 class="text-xl font-semibold tracking-tight">
              <span class="lang-en">Education</span><span class="lang-zh">教育</span>
            </h2>
          </div>

          <div class="grid gap-x-12 md:grid-cols-2">
            <div class="border-t border-rule py-8" data-reveal data-reveal="left">
              <span class="font-mono text-xs text-gold">2024 – 2027</span>
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight mt-4">M.Sc. Artificial Intelligence</h3>
              <p class="text-sm text-mid mt-2">
                Brandenburg University of Technology
                <span class="text-dim"> · Cottbus, Germany</span>
              </p>
            </div>
            <div class="border-t border-rule py-8 mt-8 md:mt-0" data-reveal data-reveal="right" style="--rd: 120ms">
              <span class="font-mono text-xs text-gold">2018 – 2022</span>
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight mt-4">B.E. Information Science &amp; Engineering</h3>
              <p class="text-sm text-mid mt-2">
                SJB Institute of Technology
                <span class="text-dim"> · Bengaluru, India</span>
              </p>
            </div>
          </div>
          <div class="border-t border-rule" aria-hidden="true" />
        </div>
      </section>

      <!-- ============================== 06 — CONTACT ============================== -->
      <section id="contact" class="py-32 md:py-44 px-6 border-t border-rule">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-baseline gap-4 mb-12" data-reveal>
            <span class="font-mono text-xs text-gold">06</span>
            <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-dim">
              <span class="lang-en">Contact</span><span class="lang-zh">联系</span>
            </span>
          </div>

          <h2 class="text-4xl sm:text-6xl md:text-7xl font-semibold tracking-[-0.02em] leading-[1.04]" data-reveal>
            <span class="mask-line">
              <span class="reveal-inner"><span class="lang-en">Let's build</span><span class="lang-zh">一起</span></span>
            </span>
            <span class="mask-line" style="--rd: 150ms">
              <span class="reveal-inner"><span class="lang-en">something</span><span class="lang-zh">构建</span> <span class="text-gold"><span class="lang-en">exceptional</span><span class="lang-zh">非凡的东西</span></span></span>
            </span>
          </h2>

          <p class="mt-8 text-base text-mid leading-relaxed max-w-xl" data-reveal style="--rd: 300ms">
            <span class="lang-en">
              Working on production AI agents, RAG pipelines, or enterprise MLOps? Let's talk.
            </span>
            <span class="lang-zh">正在做生产级 AI 智能体、RAG 管线或企业级 MLOps？欢迎交流。</span>
          </p>

          <div class="mt-14" data-reveal style="--rd: 380ms">
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-dim mb-5">
              <span class="text-gold" aria-hidden="true">→</span>
              <span class="lang-en">Get in touch</span><span class="lang-zh">联系方式</span>
            </p>
            <a href="mailto:kirantushar10@gmail.com" class="big-link text-2xl sm:text-4xl md:text-5xl font-semibold tracking-tight break-all">
              kirantushar10@gmail.com
            </a>
            <p class="mt-7 font-mono text-xs sm:text-sm text-dim">
              → kirantushar10@gmail.com<span class="caret" aria-hidden="true"></span>
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
              <a
                href="https://github.com/kirantushar10"
                target="_blank"
                rel="noopener"
                class="px-5 py-2.5 border border-rule text-sm text-mid rounded-lg hover:text-ink hover:border-gold/50 transition"
              >
                GitHub ↗
              </a>
              <a
                href="https://linkedin.com/in/kirantushar10"
                target="_blank"
                rel="noopener"
                class="px-5 py-2.5 border border-rule text-sm text-mid rounded-lg hover:text-ink hover:border-gold/50 transition"
              >
                LinkedIn ↗
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Scroll reveals
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      // Nav hairline after scrolling
      const nav = document.getElementById('site-nav');
      if (nav) {
        const onScroll = () => nav.classList.toggle('nav-scrolled', window.scrollY > 60);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Language toggle
      document.querySelectorAll('.lang-toggle button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isZh = btn.dataset.lang === 'zh';
          document.documentElement.classList.toggle('zh', isZh);
          document.querySelectorAll('.lang-toggle button').forEach((b) =>
            b.classList.toggle('active', b === btn)
          );
          try {
            localStorage.setItem('lang', isZh ? 'zh' : 'en');
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>
