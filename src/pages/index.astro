---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FlowField from '../components/FlowField';
import ProjectCard from '../components/ProjectCard';
import SkillBadge from '../components/SkillBadge.astro';
import TimelineLine from '../components/TimelineLine';
import '../styles/globals.css';

// Project Data
const featuredProjects = [
  {
    title: 'Conversational RAG Assistant',
    description: 'Production-grade conversational RAG platform utilizing semantic retrieval, memory context tracking, and low-latency inference with real-time token tracking.',
    tags: ['LangChain', 'Groq (LLaMA 3)', 'ChromaDB', 'LangSmith', 'Python'],
    featured: true,
    githubUrl: 'https://github.com/kirantushar10/Conversational-RAG-Assistant',
  },
  {
    title: 'Agentic Search Engine',
    description: 'Autonomous reasoning agent built with LangGraph that dynamically routes queries between Wikipedia, ArXiv academic papers, and live web search APIs.',
    tags: ['LangGraph', 'FAISS', 'Hugging Face', 'LangSmith', 'Python'],
    featured: true,
    githubUrl: 'https://github.com/kirantushar10/Search-Engine-with-Tools-and-Agents',
  },
  {
    title: 'End-to-End ML Pipeline',
    description: 'Complete automated MLOps pipeline handling data ingestion, validation, experiment tracking, model versioning, and CI/CD containerized deployments.',
    tags: ['MLflow', 'Docker', 'FastAPI', 'GitHub Actions', 'DVC'],
    featured: true,
    githubUrl: 'https://github.com/kirantushar10/Machine-Learning-Pipeline-with-DVC-MLflow-and-DagsHub',
  },
  {
    title: 'Automated CI/CD Flask Pipeline',
    description: 'Automated CI/CD pipeline using Pytest, Docker, and GitHub Actions for continuous build-test-deploy workflow on every git commit.',
    tags: ['Docker', 'GitHub Actions', 'Flask', 'Pytest'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/CI-CD-Pipeline-for-Dockerized-Flask-Application',
  },
  {
    title: 'Enterprise Airflow & Postgres ETL',
    description: 'Production-style Airflow pipeline pulling NASA APOD API data, transforming JSON payloads, and loading into Dockerized Postgres via custom hooks.',
    tags: ['Apache Airflow', 'PostgreSQL', 'Docker', 'ETL'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/Apache-Airflow-ETL-With-Postgres-and-API',
  },
  {
    title: 'NVIDIA NIM Document QA Assistant',
    description: 'Interactive Streamlit app leveraging NVIDIA Inference Microservices, FAISS vector search, and NVIDIA-hosted LLaMA 3.3 (70B) for deep document QA.',
    tags: ['NVIDIA NIM', 'LLaMA 3.3', 'FAISS', 'Streamlit'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/NVIDIA-NIM-RAG-Demo',
  },
  {
    title: 'Multi-Strategy Summarizer',
    description: 'High-speed document summarizer supporting Stuff, Map-Reduce, and Refine chain architectures with multilingual output and token usage telemetry.',
    tags: ['LangChain', 'Groq API', 'LLaMA 3.1', 'NLP'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/Text-Summarization-using-LangChain-and-Groq-LLaMA',
  },
  {
    title: 'Shakespeare LSTM vs GRU Model',
    description: 'Architectural benchmark comparison of LSTM vs GRU deep learning models trained on Hamlet, deployed with side-by-side interactive predictor.',
    tags: ['LSTM', 'GRU', 'TensorFlow', 'Streamlit'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/HamletGPT-Next-Word-Prediction-with-LSTM-and-GRU',
  },
  {
    title: 'Movie Review Sentiment Analysis',
    description: 'Recurrent Neural Network (RNN) binary classification model built with Keras/TensorFlow for real-time movie review sentiment inference.',
    tags: ['RNN', 'Keras', 'NLP', 'Streamlit'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/IMDB-Movie-Review-Sentiment-Analyzer-using-RNN',
  },
  {
    title: 'Financial Analytics & Time-Series ARIMA',
    description: 'Financial dashboard calculating technical indicators (RSI, MACD) and rendering 30-day ARIMA time-series price forecasts.',
    tags: ['ARIMA', 'Time Series', 'yfinance', 'Plotly'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/Stock-Market-Analysis-and-Time-Series-Forecasting',
  },
  {
    title: 'Customer Churn Prediction System',
    description: 'End-to-end deep learning churn classifier built with Keras & Scikit-learn preprocessing, deployed with an interactive web GUI.',
    tags: ['ANN', 'Deep Learning', 'Scikit-Learn', 'Streamlit'],
    featured: false,
    githubUrl: 'https://github.com/kirantushar10/ANN-Classification-Churn',
  },
];

const experiences = [
  {
    role: 'AI/ML Engineer Intern',
    company: 'Analog Devices',
    location: 'Munich, Germany',
    period: 'May 2026 – Oct 2026',
    bullets: [
      'Built an AI-assisted analytics platform cutting data exploration from ~50 min to ~10 sec via an interactive knowledge graph.',
      'Developed async FastAPI, PostgreSQL, and Docker backend with Redis session management.',
      'Automated nightly data updates with Apache Airflow ETL pipelines.',
      'Integrated LLMs via Portkey with multi-hop retrieval, model routing, and grounding checks.',
      'Built Cytoscape.js knowledge-graph UI and Chrome extension with multi-turn memory.',
    ],
  },
  {
    role: 'Student Assistant – Cyber-Physical Systems',
    company: 'Technische Universität Berlin',
    location: 'Berlin, Germany',
    period: 'Mar 2026 – Apr 2026',
    bullets: [
      'Delivered weekly ML and Python labs for 150+ engineering students.',
      'Mentored students on debugging and maintained the course GitHub repository.',
    ],
  },
  {
    role: 'Associate Software Engineer II',
    company: 'Carelon Global Solutions',
    location: 'Bengaluru, India',
    period: 'Aug 2022 – May 2023',
    bullets: [
      'Backend transaction processing on IBM z/OS with COBOL, JCL, and IBM Db2.',
      'Automated 15+ JCL scripts (saving 10+ hrs/week) and resolved 50+ production incidents.',
    ],
  },
  {
    role: 'Web Developer and Cyber Security Intern',
    company: 'Bharat Heavy Electricals Limited (BHEL)',
    location: 'Nagpur, India',
    period: 'Sept 2021 – Oct 2021',
    bullets: [
      'Reduced report generation by 30% via multi-threaded PHP/PL/SQL processing.',
      'Conducted vulnerability assessments and ISO 27001:2013 compliance testing.',
    ],
  },
];

const skillsGenerativeAI = ['LLM Applications', 'RAG Pipelines', 'AI Agents', 'LangChain', 'LangGraph', 'Hugging Face', 'LangSmith', 'Portkey', 'Groq (LLaMA 3)'];
const skillsBackendMLOps = ['FastAPI', 'Docker', 'MLflow', 'DVC', 'GitHub Actions CI/CD', 'Apache Airflow', 'AsyncIO'];
const skillsDatabases = ['ChromaDB', 'FAISS', 'PostgreSQL', 'MongoDB', 'Redis', 'MySQL', 'IBM Db2'];
const skillsLanguages = ['Python', 'TypeScript', 'JavaScript', 'SQL', 'TensorFlow', 'Keras', 'Scikit-Learn', 'Pandas / NumPy'];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>Tushar Kiran | AI/ML Engineer & RAG Specialist</title>
    <meta name="title" content="Tushar Kiran | AI/ML Engineer & RAG Specialist" />
    <meta name="description" content="AI/ML Specialist building production LLM applications, RAG pipelines, and agentic AI systems for enterprise workflows. Based in Munich, Germany." />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kirantushar10.github.io/" />
    <meta property="og:title" content="Tushar Kiran | AI/ML Engineer" />
    <meta property="og:description" content="Building AI Agents & RAG Pipelines for Enterprise Systems" />

    <!-- Type -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Enable JS-driven reveal animations
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="bg-char text-ink font-body antialiased">
    <!-- Full-page flow-field particle stream + amber scroll progress bar -->
    <FlowField client:visible />

    <!-- Film grain -->
    <div class="grain-overlay" aria-hidden="true" />

    <Navbar />

    <main class="relative z-10">
      <!-- ============================== HERO ============================== -->
      <section class="relative min-h-screen flex items-end">
        <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-32 pb-14">
          <!-- Kicker -->
          <p class="kicker mb-6" data-reveal>
            01 — Tushar Kiran · AI/ML Engineer · Munich
          </p>

          <!-- Oversized headline — line-mask rise, copy verbatim -->
          <h1
            class="font-display font-bold tracking-[-0.03em] leading-[0.98] text-[clamp(3rem,9.5vw,8.25rem)]"
            data-reveal
            style="--rd: 80ms"
          >
            <span class="mask-line"><span class="reveal-inner">Building AI</span></span>
            <span class="mask-line" style="--rd: 180ms"><span class="reveal-inner">Agents &amp;</span></span>
            <span class="mask-line" style="--rd: 280ms">
              <span class="reveal-inner"><span class="text-amber">RAG</span> Pipelines</span>
            </span>
          </h1>

          <!-- Bio + CTAs (left) / status line (right, off-grid) -->
          <div class="mt-10 md:mt-14 grid gap-10 md:grid-cols-12 items-end">
            <div class="md:col-span-5 lg:col-span-4" data-reveal style="--rd: 360ms">
              <p class="text-base sm:text-lg leading-relaxed text-ink/80">
                Hi, I&apos;m <strong class="text-ink font-semibold">Tushar Kiran</strong>. I architect
                production LLM applications, retrieval-augmented generation systems, and agentic
                workflows for enterprise engineering platforms.
              </p>
              <div class="mt-8 flex flex-wrap gap-4">
                <a
                  href="#projects"
                  class="inline-flex items-center gap-2 px-7 py-3.5 bg-amber text-char font-mono text-xs font-semibold uppercase tracking-[0.18em] hover:bg-[#ffc233] transition-colors duration-300"
                >
                  Explore Projects →
                </a>
                <a
                  href="#experience"
                  class="inline-flex items-center gap-2 px-7 py-3.5 border border-rule text-ink font-mono text-xs uppercase tracking-[0.18em] hover:border-amber-dim hover:text-amber transition-colors duration-300"
                >
                  View Experience
                </a>
              </div>
            </div>
            <div class="md:col-span-7 lg:col-span-8 flex md:justify-end" data-reveal style="--rd: 440ms">
              <p class="font-mono text-xs sm:text-sm text-muted">
                [ AI/ML Specialist · Munich, Germany ]<span class="caret" aria-hidden="true" />
              </p>
            </div>
          </div>

          <!-- Stats — hairline-divided row, mono numerals -->
          <div
            class="mt-14 md:mt-20 border-t border-rule grid grid-cols-2 md:grid-cols-4"
            data-reveal
            style="--rd: 520ms"
          >
            <div class="py-6 md:pr-8 md:border-r md:border-rule">
              <p class="font-mono text-3xl sm:text-4xl text-ink">11+</p>
              <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted">AI/ML Projects</p>
            </div>
            <div class="py-6 md:px-8 md:border-r md:border-rule">
              <p class="font-mono text-3xl sm:text-4xl text-ink">150+</p>
              <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Students Mentored</p>
            </div>
            <div class="py-6 md:px-8 md:border-r md:border-rule col-span-2 md:col-span-1">
              <p class="font-mono text-3xl sm:text-4xl text-amber">M.Sc.</p>
              <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Artificial Intelligence</p>
            </div>
            <div class="py-6 md:pl-8 col-span-2 md:col-span-1">
              <p class="font-mono text-3xl sm:text-4xl text-ink">15+</p>
              <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Batch Automation</p>
            </div>
          </div>

          <!-- Scroll cue -->
          <div class="mt-12 flex items-center gap-3 scroll-cue" aria-hidden="true">
            <span class="w-px h-8 bg-amber-dim" />
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">Scroll to explore</span>
          </div>
        </div>
      </section>

      <!-- ============================== ABOUT ============================== -->
      <section id="about" class="relative py-24 md:py-32 px-4 sm:px-6 border-t border-rule">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12 md:mb-16 flex items-end justify-between gap-6" data-reveal>
            <div>
              <p class="kicker mb-3">02 — Background</p>
              <h2 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight">About Me</h2>
            </div>
            <span class="hidden md:block font-mono text-xs text-muted">§ 02</span>
          </div>

          <div class="grid gap-12 md:grid-cols-12">
            <!-- Pull-quote statement -->
            <div class="md:col-span-7" data-reveal>
              <p class="mask-line">
                <span class="reveal-inner font-display text-2xl sm:text-3xl md:text-[2.1rem] font-medium leading-[1.25] tracking-tight text-ink">
                  Recently completed my AI/ML engineering internship at
                  <strong class="text-amber font-semibold">Analog Devices</strong>, where I built
                  an AI-assisted engineering analytics platform — an intent-aware RAG pipeline
                  over a Cytoscape.js knowledge graph, backed by FastAPI, PostgreSQL, Redis,
                  and Apache Airflow.
                </span>
              </p>
              <p class="mt-8 text-sm sm:text-base text-muted leading-relaxed max-w-xl" data-reveal style="--rd: 150ms">
                Pursuing my <strong class="text-ink font-semibold">M.Sc. in Artificial Intelligence</strong>
                at Brandenburg University of Technology (BTU Cottbus), Germany. Background in
                high-throughput backend engineering on IBM z/OS mainframes and production
                transaction processing.
              </p>
            </div>

            <!-- Info rows — hairline dividers, no cards -->
            <div class="md:col-span-5" data-reveal style="--rd: 200ms">
              <div class="border-t border-rule py-5">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.22em] text-amber mb-2">Core Focus</h3>
                <p class="text-sm text-muted leading-relaxed">
                  Agentic RAG, LangGraph multi-step reasoning, Cost-aware LLM Routing, Vector DB optimization
                </p>
              </div>
              <div class="border-t border-rule py-5">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.22em] text-amber mb-2">Education</h3>
                <p class="text-sm text-muted leading-relaxed">
                  M.Sc. Artificial Intelligence (BTU Cottbus) &amp; B.E. Information Science (SJB Institute)
                </p>
              </div>
              <div class="border-y border-rule py-5">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.22em] text-amber mb-2">Location</h3>
                <p class="text-sm text-muted leading-relaxed">
                  Munich, Germany · Open to AI Research &amp; Engineering collaborations
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== EXPERIENCE ============================== -->
      <section id="experience" class="relative py-24 md:py-32 px-4 sm:px-6 border-t border-rule">
        <div class="max-w-5xl mx-auto">
          <div class="mb-12 md:mb-16 flex items-end justify-between gap-6" data-reveal>
            <div>
              <p class="kicker mb-3">03 — Career</p>
              <h2 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight">Work Experience</h2>
            </div>
            <span class="hidden md:block font-mono text-xs text-muted">§ 03</span>
          </div>

          <div class="relative">
            <!-- Scroll-drawn amber spine -->
            <div class="absolute left-0 top-0 h-full" aria-hidden="true">
              <TimelineLine client:load />
            </div>

            <div class="space-y-14 md:space-y-20 pl-8 sm:pl-12">
              {experiences.map((exp, i) => (
                <div class="relative" data-reveal style={`--rd: ${i * 90}ms`}>
                  <!-- Amber node on the spine -->
                  <span
                    class="absolute top-2 -left-[37px] sm:-left-[53px] w-3 h-3 rounded-full bg-amber shadow-[0_0_12px_rgba(255,176,0,0.7)]"
                    aria-hidden="true"
                  />
                  <div class="border-t border-rule pt-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-3">
                      <h3 class="font-display text-xl md:text-2xl font-semibold tracking-tight text-ink">
                        {exp.role}
                      </h3>
                      <span class="font-mono text-xs text-amber whitespace-nowrap">{exp.period}</span>
                    </div>
                    <p class="text-xs sm:text-sm font-medium text-muted mb-4">
                      {exp.company} · <span class="text-muted/70">{exp.location}</span>
                    </p>
                    <ul class="space-y-2.5 text-sm text-ink/75">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start gap-3 leading-relaxed">
                          <span class="text-amber mt-px text-xs shrink-0" aria-hidden="true">▸</span>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== SKILLS ============================== -->
      <section id="skills" class="relative py-24 md:py-32 px-4 sm:px-6 border-t border-rule">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12 md:mb-16 flex items-end justify-between gap-6" data-reveal>
            <div>
              <p class="kicker mb-3">04 — Stack</p>
              <h2 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight">Technical Matrix</h2>
            </div>
            <span class="hidden md:block font-mono text-xs text-muted">§ 04</span>
          </div>

          <div class="space-y-12">
            <div data-reveal>
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-muted mb-5">
                <span class="text-amber" aria-hidden="true">—</span> Generative AI &amp; LLMs
              </p>
              <div class="marquee">
                <div class="marquee-track">
                  <div class="marquee-chips">
                    {skillsGenerativeAI.map((s) => (
                      <SkillBadge name={s} level="expert" category="ai" />
                    ))}
                  </div>
                  <div class="marquee-chips marquee-dup" aria-hidden="true">
                    {skillsGenerativeAI.map((s) => (
                      <SkillBadge name={s} level="expert" category="ai" />
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div data-reveal style="--rd: 100ms">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-muted mb-5">
                <span class="text-amber" aria-hidden="true">—</span> Backend &amp; MLOps
              </p>
              <div class="marquee marquee-reverse marquee-fast">
                <div class="marquee-track">
                  <div class="marquee-chips">
                    {skillsBackendMLOps.map((s) => (
                      <SkillBadge name={s} level="expert" category="backend" />
                    ))}
                  </div>
                  <div class="marquee-chips marquee-dup" aria-hidden="true">
                    {skillsBackendMLOps.map((s) => (
                      <SkillBadge name={s} level="expert" category="backend" />
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div data-reveal style="--rd: 200ms">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-muted mb-5">
                <span class="text-amber" aria-hidden="true">—</span> Databases &amp; Vector Search
              </p>
              <div class="marquee">
                <div class="marquee-track">
                  <div class="marquee-chips">
                    {skillsDatabases.map((s) => (
                      <SkillBadge name={s} level="proficient" category="database" />
                    ))}
                  </div>
                  <div class="marquee-chips marquee-dup" aria-hidden="true">
                    {skillsDatabases.map((s) => (
                      <SkillBadge name={s} level="proficient" category="database" />
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div data-reveal style="--rd: 300ms">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-muted mb-5">
                <span class="text-amber" aria-hidden="true">—</span> Languages &amp; Deep Learning
              </p>
              <div class="marquee marquee-reverse marquee-fast">
                <div class="marquee-track">
                  <div class="marquee-chips">
                    {skillsLanguages.map((s) => (
                      <SkillBadge name={s} level="expert" category="language" />
                    ))}
                  </div>
                  <div class="marquee-chips marquee-dup" aria-hidden="true">
                    {skillsLanguages.map((s) => (
                      <SkillBadge name={s} level="expert" category="language" />
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== PROJECTS ============================== -->
      <section id="projects" class="relative py-24 md:py-32 px-4 sm:px-6 border-t border-rule">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12 md:mb-16 flex items-end justify-between gap-6" data-reveal>
            <div>
              <p class="kicker mb-3">05 — Portfolio</p>
              <h2 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight">
                Featured AI &amp; MLOps Projects
              </h2>
              <p class="mt-3 text-sm text-muted">Production applications, RAG pipelines, and agentic workflows</p>
            </div>
            <span class="hidden md:block font-mono text-xs text-muted">§ 05</span>
          </div>

          <div class="border-b border-rule">
            {featuredProjects.map((proj, i) => (
              <ProjectCard
                client:visible
                title={proj.title}
                description={proj.description}
                tags={proj.tags}
                featured={proj.featured}
                githubUrl={proj.githubUrl}
                index={i}
              />
            ))}
          </div>
        </div>
      </section>

      <!-- ============================== EDUCATION ============================== -->
      <section id="education" class="relative py-24 md:py-32 px-4 sm:px-6 border-t border-rule">
        <div class="max-w-5xl mx-auto">
          <div class="mb-12 md:mb-16 flex items-end justify-between gap-6" data-reveal>
            <div>
              <p class="kicker mb-3">06 — Credentials</p>
              <h2 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight">Education</h2>
            </div>
            <span class="hidden md:block font-mono text-xs text-muted">§ 06</span>
          </div>

          <div class="grid gap-x-12 md:grid-cols-2">
            <div class="border-t border-rule py-8" data-reveal>
              <span class="font-mono text-xs text-amber">OCT 2024 – SEP 2027</span>
              <h3 class="font-display text-xl md:text-2xl font-semibold tracking-tight mt-4">
                M.Sc. Artificial Intelligence
              </h3>
              <p class="text-sm font-medium text-ink mt-2">
                Brandenburg University of Technology (BTU Cottbus)
              </p>
              <p class="text-xs text-muted mt-2.5 leading-relaxed">
                Cottbus, Germany
              </p>
            </div>
            <div class="border-t border-rule py-8 mt-8 md:mt-0" data-reveal style="--rd: 120ms">
              <span class="font-mono text-xs text-amber">AUG 2018 – JUL 2022</span>
              <h3 class="font-display text-xl md:text-2xl font-semibold tracking-tight mt-4">
                B.E. Information Science &amp; Engineering
              </h3>
              <p class="text-sm font-medium text-ink mt-2">SJB Institute of Technology</p>
              <p class="text-xs text-muted mt-2.5 leading-relaxed">
                Bengaluru, India
              </p>
