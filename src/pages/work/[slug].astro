---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/globals.css';
import { caseStudies } from '../../data/work';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props;
const idx = caseStudies.indexOf(cs);
const next = caseStudies[(idx + 1) % caseStudies.length];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{cs.title} — Tushar Kiran</title>
    <meta name="description" content={cs.summary} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={cs.title} />
    <meta property="og:description" content={cs.summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <Navbar />

    <main class="relative z-10">
      <article class="max-w-3xl mx-auto px-6 pt-32 pb-24 cs-prose">
        <!-- Breadcrumb -->
        <p class="font-mono text-xs text-dim mb-10" data-reveal>
          <a href="/" class="hover:text-ink transition">← All work</a>
          <span class="mx-3">/</span>{cs.index}
        </p>

        <p class="font-mono text-xs tracking-[0.2em] uppercase text-gold mb-5" data-reveal>
          {cs.year} · {cs.role}
        </p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.08]" data-reveal style="--rd: 80ms">
          {cs.title}
        </h1>
        <p class="mt-6 text-lg text-mid leading-relaxed" data-reveal style="--rd: 160ms">
          {cs.summary}
        </p>

        <!-- Stack chips -->
        <div class="mt-8 flex flex-wrap gap-2" data-reveal style="--rd: 220ms">
          {cs.stack.map((s) => (
            <span class="chip">{s}</span>
          ))}
        </div>

        <hr class="border-rule my-12" />

        <!-- Overview -->
        <h3 data-reveal>Overview</h3>
        <p data-reveal>
          {cs.overview}
        </p>

        <!-- Challenge -->
        <h3 class="mt-12" data-reveal>The Challenge</h3>
        <p data-reveal>
          {cs.challenge}
        </p>

        <!-- Approach -->
        <h3 class="mt-12" data-reveal>Approach</h3>
        <ul class="mt-4 space-y-3" data-reveal>
          {cs.approach.map((a) => (
            <li class="flex items-start gap-3">
              <span class="text-gold mt-px shrink-0" aria-hidden="true">→</span>
              <span>{a}</span>
            </li>
          ))}
        </ul>

        <!-- Outcome -->
        <h3 class="mt-12" data-reveal>Outcome</h3>
        <p data-reveal>
          {cs.outcome}
        </p>

        <!-- Repo link -->
        <div class="mt-12 flex flex-wrap gap-3" data-reveal>
          <a
            href={cs.githubUrl}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 bg-gold text-bg text-sm font-medium rounded-lg hover:brightness-110 transition"
          >
            View on GitHub ↗
          </a>
          <a
            href="/"
            class="px-5 py-2.5 border border-rule text-sm text-mid rounded-lg hover:text-ink hover:border-gold/50 transition"
          >
            ← All work
          </a>
        </div>

        <!-- Next case study -->
        <div class="mt-16 border-t border-rule pt-6">
          <p class="font-mono text-xs text-dim mb-2">Next case study</p>
          <a
            href={`/work/${next.slug}/`}
            class="text-xl font-semibold tracking-tight hover:text-gold transition"
          >
            {next.title} ↗
          </a>
        </div>
      </article>
    </main>

    <Footer />

    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      const nav = document.getElementById('site-nav');
      if (nav) {
        const onScroll = () => nav.classList.toggle('nav-scrolled', window.scrollY > 60);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
